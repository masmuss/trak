{
	"name": "@trak/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test --pass-with-no-tests",
		"db:seed": "node --import tsx/esm --env-file=../../.env src/lib/server/db/seed.ts"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.2",
		"@vitest/browser-playwright": "^4.1.11",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"embla-carousel-svelte": "^8.6.0",
		"eslint-plugin-svelte": "^3.23.0",
		"formsnap": "^2.0.1",
		"layerchart": "2.0.0-next.48",
		"paneforge": "^1.0.2",
		"phosphor-svelte": "^3.1.0",
		"playwright": "^1.63.0",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"tw-animate-css": "^1.4.0",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.3.0",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1131.0",
		"@tanstack/table-core": "^8.21.3",
		"@trak/database": "workspace:*",
		"@trak/services": "workspace:*",
		"@trak/shared": "workspace:*",
		"better-auth": "^1.7.4",
		"drizzle-orm": "^0.45.2",
		"mode-watcher": "^1.1.0",
		"postgres": "^3.4.9"
	}
}
